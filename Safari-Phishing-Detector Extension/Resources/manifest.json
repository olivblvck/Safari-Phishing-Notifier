{
  "manifest_version": 3,

  "name": "Safari Phishing Detector",
  "description": "Lokalna analiza domen (TLD, typosquatting, heurystyki) dla Safari.",
  "version": "1.0",

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/toolbar-icon.svg",
    "default_title": "Bezpieczeństwo"
  },

  "permissions": [
    "tabs",
    "activeTab"
  ]
}
